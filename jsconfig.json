{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        },
        "allowJs": true,
        "checkJs": false
    },
    "exclude": [
        "node_modules",
        "public",
        "vendor",
        "storage",
        "bootstrap/cache"
    ]
}
